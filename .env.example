# Copy this file to .env and fill in your secrets.
# .env is gitignored and will be loaded automatically by direnv via .envrc.

# UserDB API
USERDB_SERVER=147.173.81.141
USERDB_API_KEY=

# MagnetDB API
MAGNETDB_SERVER=
MAGNETDB_API_KEY=

# RustFS / S3-compatible object storage
RUSTFS_ENDPOINT=http://localhost:9000
ACCESS_KEY=
SECRET_KEY=

# NAS access (used by marimo/00_nas_setup.py)
NAS_HOST=nas.lncmi.cnrs.fr
NAS_USER=
NAS_REMOTE=lncmi_nas
NAS_MOUNT=/mnt/lncmi_nas
